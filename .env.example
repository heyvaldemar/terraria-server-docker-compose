# Copy to .env beside the compose file, then edit. .env is gitignored.
# Nothing here is required: every line has a working default in the compose
# file.

# ---------------------------------------------------------------- the world
# The in-game name, shown to players when they join.
TERRARIA_WORLD_NAME=Terraria
# The file the server starts, /worlds/<this>.wld. A world under any other
# name is not loaded: the server generates a new one under this name.
TERRARIA_WORLD_FILE=world
# Used only when the file does not exist yet: 1 small, 2 medium, 3 large.
TERRARIA_WORLD_SIZE=2
TERRARIA_MAX_PLAYERS=8
# Empty: anyone who finds the server can join. Written into config.json on
# every start, so this is where it is changed.
TERRARIA_SERVER_PASSWORD=

# ---------------------------------------------------------------- networking
# TCP. Published under the number the server binds.
TERRARIA_SERVER_PORT=7777

TERRARIA_SERVER_TIMEZONE=UTC

# ---------------------------------------------------------------- overridable defaults
# Set these only to change them; the change survives every git pull.
#
# TERRARIA_SERVER_IMAGE_VERSION=6.2.1@sha256:...
# TERRARIA_SERVER_IMAGE_TAG=ghcr.io/pryaxis/tshock:6.2.1
#
# A second server on the same host: another prefix, project name and port.
# TERRARIA_VOLUME_PREFIX=terraria-server
#
# TERRARIA_SERVER_MEMORY_LIMIT=2g
# TERRARIA_SERVER_CPU_LIMIT=2.0
# TERRARIA_SERVER_MEMORY_RESERVATION=512m
# TERRARIA_SERVER_CPU_RESERVATION=0.5
#
# The first start generates the world.
# TERRARIA_SERVER_START_PERIOD=10m
# The world is saved on the way out.
# TERRARIA_SERVER_STOP_GRACE_PERIOD=60s
# TERRARIA_SERVER_LOG_MAX_SIZE=10m
# TERRARIA_SERVER_LOG_MAX_FILE=3
#
# Backups (scripts/backup.sh): where archives go and how many are kept.
# TERRARIA_BACKUP_DIR=./backups
# TERRARIA_BACKUP_KEEP=14
